# Tikket configuration. Copy to `.env` for standalone Docker Compose, or enter the same
# variables in Coolify's "Environment Variables" tab. Never commit real values.

# ── Required ────────────────────────────────────────────────────────────────
# Public URL users open in the browser: scheme + host (+ port), no path, no trailing slash.
# Must match exactly what the browser shows; it drives CSRF protection, Secure cookies and
# every absolute link (invitations, password resets). Request headers are never used instead.
ORIGIN=https://tikket.example.com

# ── Strongly recommended ────────────────────────────────────────────────────
# ≥ 32 random characters:  openssl rand -base64 48
# If empty, a random secret is generated once and stored in the data volume. A short or
# placeholder value stops the container with an error (no silent insecure fallback).
SESSION_SECRET=

# ── Reverse proxy / client IP (read docs/deployment-coolify.md#trusted-proxies) ──
# Leave empty unless a proxy YOU control is the only way to reach Tikket. Then:
#   one proxy (Traefik, Caddy, NPM)              ADDRESS_HEADER=X-Forwarded-For  XFF_DEPTH=1
#   Cloudflare → NPM with real-IP restoration    ADDRESS_HEADER=X-Forwarded-For  XFF_DEPTH=1
#   Cloudflare → NPM without real-IP restoration ADDRESS_HEADER=X-Forwarded-For  XFF_DEPTH=2
ADDRESS_HEADER=
XFF_DEPTH=1

# ── Optional ────────────────────────────────────────────────────────────────
# Base URL for invitation/reset links if different from ORIGIN (rarely needed).
APP_URL=
# Per-image upload limit (admins can lower it in the UI) and the overall request body limit.
# BODY_SIZE_LIMIT must be ≥ MAX_UPLOAD_SIZE; keep the proxy limit (client_max_body_size) ≥ it.
MAX_UPLOAD_SIZE=10M
BODY_SIZE_LIMIT=25M
# Failed sign-ins allowed per account per 15 minutes.
LOGIN_RATE_LIMIT=10
# REST API requests per minute per token (writes: a fifth of it).
API_RATE_LIMIT=300

# ── Integrations (v0.5, all optional) ───────────────────────────────────────
# Encrypts integration secrets stored in the database (SMTP password, Discord / webhook URLs,
# signing secrets, GitHub secrets and tokens). 32 random bytes:  openssl rand -base64 32
# Never generated automatically. BACK IT UP with your data: restoring a backup needs the same
# key, otherwise stored integration secrets cannot be recovered (see docs/integrations.md).
ENCRYPTION_KEY=
# Rotation: move the old key here (comma-separated for several), set a new ENCRYPTION_KEY,
# restart – values are re-encrypted at start-up. Remove the old key afterwards.
ENCRYPTION_KEY_PREVIOUS=
# Email (SMTP). Setting SMTP_HOST configures email from the environment; it then takes
# precedence over Administration → Email. SMTP_SECURITY: starttls (587), tls (465) or none.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_REPLY_TO=
# Allow webhooks to private network addresses (e.g. an internal automation server). Off by
# default; cloud metadata and link-local addresses stay blocked either way.
OUTBOUND_ALLOW_PRIVATE_NETWORKS=false

# ── Deployment variants (only read by the matching Compose file) ────────────
# compose.external-proxy.yml: pre-existing Docker network shared with the proxy, and the
# DNS alias the proxy uses to reach Tikket (http://<alias>:3000).
PROXY_NETWORK=proxy_shared
PROXY_ALIAS=tikket
# compose.local-port.yml: host port published on 127.0.0.1 only.
HOST_PORT=3000
# compose.ghcr.yml: prebuilt image to run instead of building from source.
# TIKKET_IMAGE=ghcr.io/aljaz-h/tikket:latest
