# ── Required ────────────────────────────────────────────────────────────────
# Public URL users open in the browser (scheme + host, no trailing slash).
# Used for CSRF origin checks and secure cookies. Must match exactly.
ORIGIN=https://tikket.example.com

# Long random secret used to derive session identifiers (min. 32 chars).
# Generate one with:  openssl rand -base64 48
# If unset, a secret is generated and stored in the data volume.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Optional ────────────────────────────────────────────────────────────────
# Base URL for invitation / password-reset links (defaults to ORIGIN).
APP_URL=https://tikket.example.com

# Port published on the host (compose only) and inside the container.
HOST_PORT=3000
PORT=3000
HOST=0.0.0.0

# Storage (inside the container). Keep these on the mounted volume.
DATA_DIR=/data
# DATABASE_PATH=/data/tikket.db
# UPLOADS_DIR=/data/uploads

# Hard upper limit per uploaded image; admins can lower it in System settings.
MAX_UPLOAD_SIZE=10M
# Maximum request body. Must be larger than MAX_UPLOAD_SIZE (forms without
# JavaScript upload several images in one request).
BODY_SIZE_LIMIT=25M

# Behind a reverse proxy: take the client IP (used for rate limiting and audit
# logs) from X-Forwarded-For, trusting exactly one proxy hop.
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1

# Failed sign-in attempts allowed per account per 15 minutes.
LOGIN_RATE_LIMIT=10
